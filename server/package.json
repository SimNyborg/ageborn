{
  "name": "ageborn-server-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local spike of Ageborn online 1v1: a Cloudflare Worker with one Durable Object per match (docs/online-spike.md).",
  "scripts": {
    "build:client": "node build-client.mjs",
    "dev": "wrangler dev --port 5063 --ip 127.0.0.1",
    "e2e": "node test/e2e.mjs",
    "bench": "esbuild test/bench.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=test/results/bench.mjs --log-level=warning && node test/results/bench.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
}
