{
  "name": "ageborn",
  "version": "0.1.0",
  "private": true,
  "description": "Ageborn: a browser-first one-lane tug-of-war battler with a card meta. Offline, no real money.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "npm run build && npm run preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "bench": "vitest bench --run",
    "size": "tsx tools/size.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "fflate": "0.8.3",
    "pixi.js": "8.21.0",
    "preact": "10.29.8",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
